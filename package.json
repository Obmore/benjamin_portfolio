{
  "name": "benjamin_portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "gh workflow run deploy.yml --ref main",
    "build:fonts": "node scripts/build-fonts.mjs",
    "check:size": "node scripts/check-budgets.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:cv": "node scripts/check-cv-size.mjs",
    "check:megrendeles": "node scripts/check-megrendeles.mjs",
    "check:static": "node scripts/check-static-pages.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm run check:size && npm run check:motion && npm run check:cv && npm run check:megrendeles && npm run check:static && npm run check:privacy"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zdog": "1.1.3"
  },
  "devDependencies": {

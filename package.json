{
  "name": "benjamin_portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/3d-bake.mjs && vite",
    "build": "node scripts/3d-bake.mjs && tsc -b && vite build",
    "build:qa": "node scripts/3d-bake.mjs && tsc -b && VITE_3D_QA=true vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "build:fonts": "node scripts/build-fonts.mjs",
    "bake:3d": "node scripts/3d-bake.mjs",
    "check:size": "node scripts/check-budgets.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:cv": "node scripts/check-cv-size.mjs",
    "check:3d": "node scripts/check-3d.mjs",
    "check": "npm run lint && npm run build && npm run check:size && npm run check:motion && npm run check:cv && npm run check:3d"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capsizecss/metrics": "^4.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}

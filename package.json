    "@capsizecss/metrics": "^4.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/zdog": "1.1.7",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
